{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wpc/author",
  "version": "1.0.0",
  "title": "WPC Author",
  "category": "widgets",
  "icon": "admin-users",
  "description": "Display author information with avatar and bio.",
  "keywords": ["author", "user", "profile", "bio"],
  "textdomain": "wp-components",
  "usesContext": ["postId"],
  "attributes": {
    "showAvatar": {
      "type": "boolean",
      "default": true
    },
    "showDescription": {
      "type": "boolean",
      "default": true
    },
    "showName": {
      "type": "boolean",
      "default": true
    },
    "imageFloat": {
      "type": "string",
      "default": "none",
      "enum": ["none", "left", "right"]
    },
    "imageRounded": {
      "type": "boolean",
      "default": true
    },
    "prepend": {
      "type": "string",
      "default": ""
    },
    "jobTitle": {
      "type": "string",
      "default": ""
    },
    "schema": {
      "type": "boolean",
      "default": true
    },
    "className": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "align": ["left", "center", "right", "wide"],
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "render": "file:./render.php"
}
