{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wpc/content",
  "version": "1.0.0",
  "title": "WPC Content",
  "category": "theme",
  "icon": "text-page",
  "description": "Displays post content or excerpt from WP-Components.",
  "keywords": [
    "content",
    "excerpt",
    "post",
    "text"
  ],
  "textdomain": "wp-components",
  "attributes": {
    "type": {
      "type": "string",
      "default": "content",
      "enum": ["content", "excerpt"]
    },
    "content": {
      "type": "string",
      "default": ""
    },
    "schema": {
      "type": "boolean",
      "default": true
    },
    "className": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "align": ["wide", "full"],
    "spacing": {
      "margin": true,
      "padding": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    }
  },
  "render": "file:./render.php"
}
