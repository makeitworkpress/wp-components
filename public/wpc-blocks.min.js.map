{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wpc/sidebar",
  "version": "1.0.0",
  "title": "WPC Sidebar",
  "category": "theme",
  "icon": "columns",
  "description": "Displays a WordPress widget sidebar from WP-Components.",
  "keywords": [
    "sidebar",
    "widgets",
    "aside"
  ],
  "textdomain": "wp-components",
  "attributes": {
    "sidebars": {
      "type": "array",
      "default": []
    },
    "className": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "align": ["left", "right", "wide", "full"],
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "render": "file:./render.php"
}
