{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wpc/posts",
  "version": "1.0.0",
  "title": "WPC Posts",
  "category": "widgets",
  "icon": "grid-view",
  "description": "Display a grid or list of posts.",
  "keywords": ["posts", "blog", "archive", "grid"],
  "textdomain": "wp-components",
  "attributes": {
    "postType": { "type": "string", "default": "post" },
    "postsPerPage": { "type": "integer", "default": 6 },
    "columns": { "type": "integer", "default": 3 },
    "layout": { "type": "string", "default": "grid", "enum": ["grid", "list"] },
    "showImage": { "type": "boolean", "default": true },
    "showExcerpt": { "type": "boolean", "default": true },
    "showDate": { "type": "boolean", "default": true },
    "showAuthor": { "type": "boolean", "default": false },
    "categories": { "type": "array", "default": [] },
    "orderBy": { "type": "string", "default": "date" },
    "order": { "type": "string", "default": "DESC" },
    "ajax": { "type": "boolean", "default": false },
    "className": { "type": "string", "default": "" }
  },
  "supports": { "html": false, "align": ["wide", "full"] },
  "render": "file:./render.php"
}
