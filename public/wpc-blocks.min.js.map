{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wpc/button",
  "version": "1.0.0",
  "title": "WPC Button",
  "category": "design",
  "icon": "button",
  "description": "A button component with icon support from WP-Components.",
  "keywords": [
    "button",
    "link",
    "cta",
    "call to action"
  ],
  "textdomain": "wp-components",
  "attributes": {
    "label": {
      "type": "string",
      "default": ""
    },
    "url": {
      "type": "string",
      "default": ""
    },
    "linkTarget": {
      "type": "string",
      "default": "_self"
    },
    "iconBefore": {
      "type": "string",
      "default": ""
    },
    "iconAfter": {
      "type": "string",
      "default": ""
    },
    "iconVisible": {
      "type": "string",
      "default": "standard",
      "enum": [
        "standard",
        "hover"
      ]
    },
    "size": {
      "type": "string",
      "default": "",
      "enum": [
        "",
        "small",
        "large",
        "none"
      ]
    },
    "backgroundColor": {
      "type": "string",
      "default": ""
    },
    "textColor": {
      "type": "string",
      "default": ""
    },
    "className": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "align": [
      "left",
      "center",
      "right",
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true
    },
    "typography": {
      "fontSize": true
    }
  },
  "render": "file:./render.php"
}