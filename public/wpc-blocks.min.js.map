{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wpc/terms",
  "version": "1.0.0",
  "title": "WPC Terms",
  "category": "widgets",
  "icon": "tag",
  "description": "Display post terms/categories.",
  "keywords": ["terms", "tags", "categories", "taxonomy"],
  "textdomain": "wp-components",
  "usesContext": ["postId"],
  "attributes": {
    "taxonomy": { "type": "string", "default": "category" },
    "separator": { "type": "string", "default": ", " },
    "link": { "type": "boolean", "default": true },
    "className": { "type": "string", "default": "" }
  },
  "supports": { "html": false },
  "render": "file:./render.php"
}
