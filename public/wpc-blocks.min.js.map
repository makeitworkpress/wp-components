{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wpc/copyright",
  "version": "1.0.0",
  "title": "WPC Copyright",
  "category": "theme",
  "icon": "info-outline",
  "description": "Displays a copyright notice with schema markup from WP-Components.",
  "keywords": [
    "copyright",
    "footer",
    "legal",
    "year"
  ],
  "textdomain": "wp-components",
  "attributes": {
    "copyright": {
      "type": "string",
      "default": "©"
    },
    "date": {
      "type": "string",
      "default": ""
    },
    "name": {
      "type": "string",
      "default": ""
    },
    "itemtype": {
      "type": "string",
      "default": "http://schema.org/Organization"
    },
    "className": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "align": ["left", "center", "right"],
    "spacing": {
      "margin": true,
      "padding": true
    },
    "typography": {
      "fontSize": true
    }
  },
  "render": "file:./render.php"
}
