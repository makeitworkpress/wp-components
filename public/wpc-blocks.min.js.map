{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wpc/image",
  "version": "1.0.0",
  "title": "WPC Image",
  "category": "media",
  "icon": "format-image",
  "description": "Display an image with optional link and enlarge functionality.",
  "keywords": ["image", "picture", "photo", "media"],
  "textdomain": "wp-components",
  "attributes": {
    "image": {
      "type": "integer",
      "default": 0
    },
    "size": {
      "type": "string",
      "default": "large"
    },
    "link": {
      "type": "string",
      "default": ""
    },
    "enlarge": {
      "type": "boolean",
      "default": false
    },
    "schema": {
      "type": "boolean",
      "default": true
    },
    "className": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "align": ["left", "center", "right", "wide", "full"],
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "render": "file:./render.php"
}
