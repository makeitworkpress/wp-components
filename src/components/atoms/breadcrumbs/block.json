{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wpc/breadcrumbs",
  "version": "1.0.0",
  "title": "WPC Breadcrumbs",
  "category": "widgets",
  "icon": "arrow-right-alt",
  "description": "Display breadcrumb navigation.",
  "keywords": ["breadcrumbs", "navigation", "path"],
  "textdomain": "wp-components",
  "attributes": {
    "separator": { "type": "string", "default": "/" },
    "showHome": { "type": "boolean", "default": true },
    "homeLabel": { "type": "string", "default": "Home" },
    "schema": { "type": "boolean", "default": true },
    "className": { "type": "string", "default": "" }
  },
  "supports": { "html": false, "align": ["left", "center", "right"] },
  "render": "file:./render.php"
}
