{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wpc/map",
  "version": "1.0.0",
  "title": "WPC Map",
  "category": "embed",
  "icon": "location-alt",
  "description": "Google Maps embed component.",
  "keywords": ["map", "google", "location", "address"],
  "textdomain": "wp-components",
  "attributes": {
    "lat": {
      "type": "string",
      "default": ""
    },
    "lng": {
      "type": "string",
      "default": ""
    },
    "zoom": {
      "type": "integer",
      "default": 14
    },
    "height": {
      "type": "string",
      "default": "400px"
    },
    "markers": {
      "type": "array",
      "default": []
    },
    "className": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "align": ["wide", "full"]
  },
  "render": "file:./render.php"
}
