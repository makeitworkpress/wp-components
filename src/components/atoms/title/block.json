{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wpc/title",
  "version": "1.0.0",
  "title": "WPC Title",
  "category": "text",
  "icon": "heading",
  "description": "Display a title with optional link and heading level.",
  "keywords": ["title", "heading", "headline"],
  "textdomain": "wp-components",
  "attributes": {
    "title": {
      "type": "string",
      "default": ""
    },
    "tag": {
      "type": "string",
      "default": "h2",
      "enum": ["h1", "h2", "h3", "h4", "h5", "h6"]
    },
    "link": {
      "type": "string",
      "default": ""
    },
    "schema": {
      "type": "boolean",
      "default": true
    },
    "className": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "align": ["left", "center", "right"],
    "typography": {
      "fontSize": true
    },
    "color": {
      "text": true,
      "background": false
    }
  },
  "render": "file:./render.php"
}
