{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wpc/rate",
  "version": "1.0.0",
  "title": "WPC Rating",
  "category": "widgets",
  "icon": "star-filled",
  "description": "A star rating component.",
  "keywords": ["rating", "stars", "review", "vote"],
  "textdomain": "wp-components",
  "usesContext": ["postId"],
  "attributes": {
    "max": {
      "type": "integer",
      "default": 5
    },
    "allowVote": {
      "type": "boolean",
      "default": true
    },
    "showCount": {
      "type": "boolean",
      "default": true
    },
    "className": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "align": ["left", "center", "right"]
  },
  "render": "file:./render.php"
}
