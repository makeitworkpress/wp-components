{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wpc/search",
  "version": "1.0.0",
  "title": "WPC Search",
  "category": "widgets",
  "icon": "search",
  "description": "A search form with optional AJAX live search.",
  "keywords": ["search", "find", "query", "ajax"],
  "textdomain": "wp-components",
  "attributes": {
    "ajax": {
      "type": "boolean",
      "default": false
    },
    "collapse": {
      "type": "boolean",
      "default": false
    },
    "allText": {
      "type": "string",
      "default": "View all search results"
    },
    "noneText": {
      "type": "string",
      "default": "No results found"
    },
    "searchDelay": {
      "type": "integer",
      "default": 500
    },
    "minLength": {
      "type": "integer",
      "default": 3
    },
    "resultsNumber": {
      "type": "integer",
      "default": 5
    },
    "postTypes": {
      "type": "string",
      "default": ""
    },
    "className": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "align": ["left", "center", "right"]
  },
  "render": "file:./render.php"
}
