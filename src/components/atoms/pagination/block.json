{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wpc/pagination",
  "version": "1.0.0",
  "title": "WPC Pagination",
  "category": "widgets",
  "icon": "controls-back",
  "description": "Display pagination links.",
  "keywords": ["pagination", "pages", "navigation"],
  "textdomain": "wp-components",
  "attributes": {
    "type": { "type": "string", "default": "numbers", "enum": ["numbers", "prevnext"] },
    "prevText": { "type": "string", "default": "Previous" },
    "nextText": { "type": "string", "default": "Next" },
    "className": { "type": "string", "default": "" }
  },
  "supports": { "html": false, "align": ["left", "center", "right"] },
  "render": "file:./render.php"
}
