{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wpc/tabs",
  "version": "1.0.0",
  "title": "WPC Tabs",
  "category": "design",
  "icon": "table-row-after",
  "description": "Display content in tabbed interface.",
  "keywords": ["tabs", "navigation", "toggle", "sections"],
  "textdomain": "wp-components",
  "attributes": {
    "tabs": {
      "type": "array",
      "default": []
    },
    "position": {
      "type": "string",
      "default": "top",
      "enum": ["top", "bottom", "left", "right"]
    },
    "hoverItem": {
      "type": "string",
      "default": ""
    },
    "className": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "align": ["wide", "full"],
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "render": "file:./render.php"
}
