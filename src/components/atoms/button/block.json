{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wpc/cart",
  "version": "1.0.0",
  "title": "WPC Cart",
  "category": "woocommerce",
  "icon": "cart",
  "description": "WooCommerce mini cart with item count.",
  "keywords": ["cart", "woocommerce", "shop", "basket"],
  "textdomain": "wp-components",
  "attributes": {
    "icon": {
      "type": "string",
      "default": "fas fa-shopping-cart"
    },
    "showCount": {
      "type": "boolean",
      "default": true
    },
    "className": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "align": ["left", "center", "right"]
  },
  "render": "file:./render.php"
}
