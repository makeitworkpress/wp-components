{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wpc/description",
  "version": "1.0.0",
  "title": "WPC Description",
  "category": "theme",
  "icon": "editor-paragraph",
  "description": "Displays a description or subtitle from WP-Components.",
  "keywords": [
    "description",
    "subtitle",
    "text"
  ],
  "textdomain": "wp-components",
  "attributes": {
    "description": {
      "type": "string",
      "default": ""
    },
    "tag": {
      "type": "string",
      "default": "p",
      "enum": ["p", "span", "div", "h2", "h3", "h4", "h5", "h6"]
    },
    "schema": {
      "type": "boolean",
      "default": true
    },
    "className": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "align": ["left", "center", "right", "wide", "full"],
    "spacing": {
      "margin": true,
      "padding": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    }
  },
  "render": "file:./render.php"
}
