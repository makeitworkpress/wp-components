{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wpc/meta",
  "version": "1.0.0",
  "title": "WPC Meta",
  "category": "theme",
  "icon": "admin-post",
  "description": "Displays post meta data by key from WP-Components.",
  "keywords": [
    "meta",
    "custom field",
    "post meta",
    "data"
  ],
  "textdomain": "wp-components",
  "attributes": {
    "key": {
      "type": "string",
      "default": ""
    },
    "before": {
      "type": "string",
      "default": ""
    },
    "after": {
      "type": "string",
      "default": ""
    },
    "className": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "align": ["left", "center", "right"],
    "spacing": {
      "margin": true,
      "padding": true
    },
    "typography": {
      "fontSize": true
    }
  },
  "render": "file:./render.php"
}
