{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wpc/section",
  "version": "1.0.0",
  "title": "WPC Section",
  "category": "design",
  "icon": "align-wide",
  "description": "A flexible section container with background options.",
  "keywords": ["section", "container", "wrapper", "row"],
  "textdomain": "wp-components",
  "attributes": {
    "container": { "type": "boolean", "default": true },
    "fullHeight": { "type": "boolean", "default": false },
    "parallax": { "type": "boolean", "default": false },
    "backgroundImage": { "type": "integer", "default": 0 },
    "backgroundColor": { "type": "string", "default": "" },
    "overlayColor": { "type": "string", "default": "" },
    "overlayOpacity": { "type": "number", "default": 0.5 },
    "videoBackground": { "type": "string", "default": "" },
    "className": { "type": "string", "default": "" }
  },
  "supports": { "html": false, "align": ["wide", "full"], "spacing": { "padding": true, "margin": true } },
  "render": "file:./render.php"
}
